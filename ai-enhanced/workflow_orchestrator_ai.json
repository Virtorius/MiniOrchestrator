{
  "name": "orchestrator_test_ai",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "search-request-ai",
        "responseMode": "responseNode"
      },
      "id": "orch-ai-0001-0001-0001-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an assistant for extracting parameters from search requests for places (restaurants, cafes, events). Extract: date (YYYY-MM-DD), time (HH:MM), guests (number), location (Center/North/South/East/West), intent (search_options/booking_request/cancel_request). Return ONLY valid JSON: {\"date\": \"2026-03-16\", \"time\": \"19:00\", \"guests\": 2, \"location\": \"Center\", \"intent\": \"search_options\"}"
            },
            {
              "role": "user",
              "content": "={{ $json.message }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json_object",
          "temperature": 0
        }
      },
      "id": "orch-ai-0002-0002-0002-000000000002",
      "name": "Extract Parameters (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [450, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-credential-id",
          "name": "OpenAI API"
        }
      },
      "retry": {
        "maxRetries": 2,
        "retryInterval": 1000
      }
    },
    {
      "parameters": {
        "jsCode": "const openAiResponse = $input.first()?.json ?? {};\nconst webhookData = $input.all()[0]?.json ?? {};\nconst message = webhookData.message || '';\nconst userId = webhookData.user_id || 'unknown';\nlet extractedData;\ntry {\n  const aiContent = openAiResponse.message || openAiResponse;\n  const parsed = typeof aiContent === 'string' ? JSON.parse(aiContent) : aiContent;\n  extractedData = { date: parsed.date || null, time: parsed.time || null, guests: parsed.guests || null, location: parsed.location || null, intent: parsed.intent || 'unknown' };\n} catch (e) {\n  extractedData = { date: null, time: null, guests: null, location: null, intent: 'unknown' };\n}\nconst sessionId = 'sess_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8);\nreturn { user_id: userId, session_id: sessionId, message: message, intent: extractedData.intent, extracted_data: extractedData, raw_input: { user_id: userId, message: message }, timestamp: new Date().toISOString() };"
      },
      "id": "orch-ai-0003-0003-0003-000000000003",
      "name": "Process AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first()?.json ?? {};\nconst extracted = inputData.extracted_data || {};\nconst requiredFields = ['date', 'time', 'guests', 'location'];\nconst missingFields = requiredFields.filter(field => !extracted[field]);\nconst isValid = missingFields.length === 0;\nreturn { ...inputData, validation: { is_valid: isValid, missing_fields: missingFields, checked_at: new Date().toISOString() } };"
      },
      "id": "orch-ai-0004-0004-0004-000000000004",
      "name": "Validate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.validation.is_valid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "orch-ai-0005-0005-0005-000000000005",
      "name": "Validation Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "session_state",
        "columns": "user_id, session_id, intent, data, status",
        "values": "={{ $json.user_id }}, {{ $json.session_id }}, {{ $json.intent }}, {{ JSON.stringify($json) }}, 'processing'"
      },
      "id": "orch-ai-0006-0006-0006-000000000006",
      "name": "Save Session State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1250, 200],
      "retry": {
        "maxRetries": 3,
        "retryInterval": 1000
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "session_id",
              "value": "={{ $json.session_id }}"
            },
            {
              "name": "intent",
              "value": "={{ $json.intent }}"
            },
            {
              "name": "user_id",
              "value": "={{ $json.user_id }}"
            }
          ]
        }
      },
      "id": "orch-ai-0007-0007-0007-000000000007",
      "name": "Store Session Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "search_worker_test"
        },
        "inputs": {
          "date": "={{ $json.extracted_data.date }}",
          "time": "={{ $json.extracted_data.time }}",
          "guests": "={{ $json.extracted_data.guests }}",
          "location": "={{ $json.extracted_data.location }}"
        }
      },
      "id": "orch-ai-0008-0008-0008-000000000008",
      "name": "Call Search Worker",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1650, 200],
      "retry": {
        "maxRetries": 3,
        "retryInterval": 2000
      }
    },
    {
      "parameters": {
        "jsCode": "const workerResponse = $input.first()?.json ?? {};\nconst sessionContext = $input.all()[1]?.json ?? {};\nreturn { status: 'success', intent: sessionContext.intent || 'search_options', session_id: sessionContext.session_id, results: workerResponse.results || [], results_count: workerResponse.results_count || 0, search_params: workerResponse.search_params, timestamp: new Date().toISOString() };"
      },
      "id": "orch-ai-0009-0009-0009-000000000009",
      "name": "Format Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first()?.json ?? {};\nreturn { status: 'missing_data', intent: inputData.intent || 'search_options', missing_fields: inputData.validation?.missing_fields || [], message: 'Missing data: ' + (inputData.validation?.missing_fields || []).join(', '), session_id: inputData.session_id, timestamp: new Date().toISOString() };"
      },
      "id": "orch-ai-0010-0010-0010-000000000010",
      "name": "Format Missing Data Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first()?.json?.error ?? new Error('Orchestrator error');\nconst sessionData = $input.all()[0]?.json ?? {};\nreturn { status: 'error', intent: sessionData.intent || 'unknown', session_id: sessionData.session_id || 'unknown', message: error.message || 'Worker execution failed', error_type: 'orchestrator_error', timestamp: new Date().toISOString() };"
      },
      "id": "orch-ai-0011-0011-0011-000000000011",
      "name": "Error Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1850, 500]
    },
    {
      "parameters": {
        "onError": "continueErrorOutput"
      },
      "id": "orch-ai-0012-0012-0012-000000000012",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [1650, 500]
    },
    {
      "parameters": {
        "jsCode": "const sessionData = $input.first()?.json ?? {};\nconst responseStatus = sessionData.status || 'completed';\nreturn { session_id: sessionData.session_id, new_status: responseStatus === 'error' ? 'error' : 'completed', updated_at: new Date().toISOString() };"
      },
      "id": "orch-ai-0013-0013-0013-000000000013",
      "name": "Update Session State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2250, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE session_state SET status = $1, updated_at = NOW() WHERE session_id = $2;",
        "additionalFields": {
          "queryReplacement": "={{ $json.new_status }}, {{ $json.session_id }}"
        }
      },
      "id": "orch-ai-0014-0014-0014-000000000014",
      "name": "Update Session State (DB)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2450, 200],
      "retry": {
        "maxRetries": 2,
        "retryInterval": 1000
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "orch-ai-0015-0015-0015-000000000015",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2650, 300]
    }
  ],
  "connections": {
